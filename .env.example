# Скопируй в .env (не коммитится) и заполни. Загрузчик .env в Django не встроен:
# экспортируй переменные окружения сам или используй обёртку (direnv, docker-env).

# Обязательно при DJANGO_DEBUG=False — иначе сервер не стартует
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# False на проде: включает HSTS, secure cookies, SSL redirect
DJANGO_DEBUG=True

# Домены через запятую (на проде добавь свой домен)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Схема+домен через запятую, нужен за прокси/на проде для CSRF
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# PostgreSQL вместо SQLite (требует requirements-prod.txt)
# DB_ENGINE=postgres
# DB_NAME=klab
# DB_USER=klab
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Redis для кэша (rate limit TTS, кэш учебника; требует requirements-prod.txt)
# REDIS_URL=redis://localhost:6379/1

# Не задавай вручную, если Django стоит за прокси, терминирующим HTTPS
# (используется автоматически при DEBUG=False)
# HTTP_X_FORWARDED_PROTO=https
